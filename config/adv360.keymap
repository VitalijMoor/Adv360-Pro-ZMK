#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    /* Bring in all your macro definitions once, at the *top‑level* */
    #include "macros.dtsi"
    #include "version.dtsi"

    /* ────────────────────────── Key‑Overrides ───────────────────────── */
    key-overrides {
        compatible = "zmk,key-overrides";

        dot_colon: dot_colon {
            compatible     = "zmk,key-override";
            if-pressed     = <&kp DOT>;
            and-modifiers  = <(MOD_LSFT|MOD_RSFT)>;
            then-pressed   = <&kp COLON>;
        };

        comma_semicolon: comma_semicolon {
            compatible     = "zmk,key-override";
            if-pressed     = <&kp COMMA>;
            and-modifiers  = <(MOD_LSFT|MOD_RSFT)>;
            then-pressed   = <&kp SEMI>;
        };
    };

    /* ────────────────────────── Behaviors ───────────────────────────── */
    behaviors {

        /* Shift‑aware “mod‑morph” wrappers that point at the new umlaut
         * Alt‑code macros.  These stay exactly the same – only the
         * underlying macros changed. */
        MM_UM_A: mm_umlaut_a {
            compatible      = "zmk,behavior-mod-morph";
            #binding-cells  = <0>;
            mods            = <(MOD_LSFT|MOD_RSFT)>;
            bindings        = <&umlaut_a &umlaut_a_cap>;
        };

        MM_UM_O: mm_umlaut_o {
            compatible      = "zmk,behavior-mod-morph";
            #binding-cells  = <0>;
            mods            = <(MOD_LSFT|MOD_RSFT)>;
            bindings        = <&umlaut_o &umlaut_o_cap>;
        };

        MM_UM_U: mm_umlaut_u {
            compatible      = "zmk,behavior-mod-morph";
            #binding-cells  = <0>;
            mods            = <(MOD_LSFT|MOD_RSFT)>;
            bindings        = <&umlaut_u &umlaut_u_cap>;
        };

        /* Homerow‑mod template (unchanged) */
        hm: homerow_mods {
            compatible        = "zmk,behavior-hold-tap";
            label             = "HOMEROW_MODS";
            #binding-cells    = <2>;
            tapping-term-ms   = <200>;
            flavor            = "tap-preferred";
            bindings          = <&kp>, <&kp>;
        };
    };

    /* ────────────────────────── Key‑maps / Layers ───────────────────── */
    keymap {
        compatible = "zmk,keymap";

        /* Base layer (excerpt – only umlaut references changed) */
        default_layer {
            display-name = "Base";
            bindings = <
  &kp ESC           &kp N1    &kp N2    &kp N3        &kp N4  &kp N5  &none                                                     &mo 3    &kp N6  &kp N7  &kp N8             &kp N9    &kp N0     &kp MINUS
  &kp TAB           &kp Q     &kp W     &kp E         &kp R   &kp T   &none                                                     &none    &kp Z   &kp U   &kp I              &kp O     &kp P      &MM_UM_U
&kp BACKSPACE     &kp A     &kp S     &kp D         &kp F   &kp G   &none      &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &kp DEL  &kp H   &kp J   &kp K              &kp L     &MM_UM_O     &MM_UM_A
&kp LSHFT         &kp Y     &kp X     &kp C         &kp V   &kp B                         &kp HOME      &kp PG_UP                      &kp N   &kp M   &kp COMMA          &kp DOT   &kp MINUS  &kp RSHFT
&kp LEFT_CONTROL  &kp LGUI  &kp CAPS  &kp LEFT_ALT  &mo 1           &kp SPACE  &mo 1      &kp END       &kp PG_DN  &mo 2      &kp RET          &mo 1   &kp RIGHT_CONTROL  &kp CAPS  &kp RGUI   &kp RIGHT_CONTROL
            >;
        };

        /* Remaining layers (‘keypad’, ‘fn’, ‘mod’, …) stay untouched */
        /* … */
    };
};

